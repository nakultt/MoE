<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Views.ApiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MoE.ModelManager.Models"
    IsTabStop="False">

  <Grid
      MaxWidth="{StaticResource PageContentMaxWidth}"
      Padding="{StaticResource PagePadding}"
      HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Uid="ApiHeading" Style="{StaticResource PageTitleTextStyle}" />
    <TextBlock
        x:Uid="ApiHint"
        Grid.Row="1"
        Margin="0,6,0,20"
        Style="{StaticResource SecondaryBodyTextStyle}"
        TextWrapping="Wrap" />

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Padding="18" Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="4">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE943;" />
            <TextBlock
                x:Uid="LocalEndpointHeading"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Border
                Grid.Column="2"
                Height="24"
                Padding="10,0,12,0"
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.IsApiListening, Mode=OneWay}">
              <StackPanel
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="7">
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.ApiStatusText, Mode=OneWay}" />
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock x:Uid="LocalEndpointHint" Style="{StaticResource SecondaryBodyTextStyle}" />
          <Grid Margin="0,12,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Padding="11,6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
              <TextBlock
                  x:Uid="LocalEndpointUrl"
                  AutomationProperties.AutomationId="LocalApiUrl"
                  FontFamily="Cascadia Mono, Consolas"
                  IsTextSelectionEnabled="True"
                  Text="{x:Bind ViewModel.ApiBaseUrl, Mode=OneTime}"
                  TextTrimming="CharacterEllipsis" />
            </Border>
            <Button
                x:Uid="CopyLocalUrlButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="CopyLocalUrlButton"
                Click="OnCopyLocalUrlClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                <TextBlock x:Uid="CopyButtonText" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <Border
          Grid.Column="1"
          Padding="18"
          Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="4">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE774;" />
            <TextBlock
                x:Name="NetworkAccessHeading"
                x:Uid="NetworkAccessHeading"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ToggleSwitch
                x:Uid="NetworkAccessToggle"
                Grid.Column="2"
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NetworkAccessToggle"
                AutomationProperties.LabeledBy="{x:Bind NetworkAccessHeading}"
                IsOn="{x:Bind ViewModel.IsNetworkAccessEnabled, Mode=TwoWay}" />
          </Grid>
          <TextBlock
              Style="{StaticResource SecondaryBodyTextStyle}"
              Text="{x:Bind ViewModel.NetworkApiStatusText, Mode=OneWay}"
              TextWrapping="Wrap" />
          <Grid
              Margin="0,12,0,0"
              ColumnSpacing="8"
              Visibility="{x:Bind ViewModel.IsNetworkAccessEnabled, Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Padding="11,6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
              <TextBlock
                  x:Uid="NetworkEndpointUrl"
                  AutomationProperties.AutomationId="NetworkApiUrl"
                  FontFamily="Cascadia Mono, Consolas"
                  IsTextSelectionEnabled="True"
                  Text="{x:Bind ViewModel.NetworkApiBaseUrl, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis" />
            </Border>
            <Button
                x:Uid="CopyNetworkUrlButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="CopyNetworkUrlButton"
                Click="OnCopyNetworkUrlClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                <TextBlock x:Uid="CopyButtonText" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <InfoBar
        x:Uid="NetworkWarningInfoBar"
        Grid.Row="3"
        Margin="0,12,0,0"
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.IsNetworkAccessEnabled, Mode=OneWay}"
        Severity="Warning"
        Visibility="{x:Bind ViewModel.IsNetworkAccessEnabled, Mode=OneWay}" />

    <Grid Grid.Row="4" Margin="0,24,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Uid="ActivityHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Uid="ActivitySubheading" Style="{StaticResource SecondaryCaptionTextStyle}" />
      </StackPanel>
      <Button
          x:Uid="ClearActivityButton"
          Grid.Column="1"
          VerticalAlignment="Center"
          AutomationProperties.AutomationId="ClearActivityButton"
          Command="{x:Bind ViewModel.ClearActivityCommand}"
          IsEnabled="{x:Bind ViewModel.HasMetrics, Mode=OneWay}"
          Style="{StaticResource SubtleButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon FontSize="14" Glyph="&#xE74D;" />
          <TextBlock x:Uid="ClearActivityText" />
        </StackPanel>
      </Button>
    </Grid>

    <Border
        Grid.Row="5"
        Padding="0"
        Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Uid="ActivityTimeColumn" Style="{StaticResource SecondaryCaptionTextStyle}" FontWeight="SemiBold" />
          <TextBlock x:Uid="ActivitySourceColumn" Grid.Column="1" Style="{StaticResource SecondaryCaptionTextStyle}" FontWeight="SemiBold" />
          <TextBlock x:Uid="ActivityEndpointColumn" Grid.Column="2" Style="{StaticResource SecondaryCaptionTextStyle}" FontWeight="SemiBold" />
          <TextBlock x:Uid="ActivityModelColumn" Grid.Column="3" Style="{StaticResource SecondaryCaptionTextStyle}" FontWeight="SemiBold" />
          <TextBlock x:Uid="ActivityQuantityColumn" Grid.Column="4" Style="{StaticResource SecondaryCaptionTextStyle}" FontWeight="SemiBold" />
          <TextBlock x:Uid="ActivityPerformanceColumn" Grid.Column="5" Style="{StaticResource SecondaryCaptionTextStyle}" FontWeight="SemiBold" />
        </Grid>
        <StackPanel
            Grid.Row="1"
            Margin="24,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasNoMetrics, Mode=OneWay}">
          <FontIcon
              FontSize="28"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              Glyph="&#xE81C;" />
          <TextBlock
              x:Uid="NoActivity"
              HorizontalAlignment="Center"
              Style="{StaticResource SecondaryBodyTextStyle}" />
        </StackPanel>
        <ListView
            x:Name="ActivityList"
            x:Uid="ActivityList"
            Grid.Row="1"
            AutomationProperties.AutomationId="RequestActivityList"
            ItemsSource="{x:Bind ViewModel.RequestMetrics, Mode=OneWay}"
            SelectionMode="None">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="16,0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="MinHeight" Value="44" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:RequestMetric">
              <Grid Padding="0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind TimeSummary}" />
                <Border
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource TagBorderStyle}">
                  <TextBlock
                      FontSize="11"
                      FontWeight="SemiBold"
                      Text="{x:Bind Source}" />
                </Border>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    Text="{x:Bind Endpoint}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Endpoint}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="{x:Bind Model}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Model}" />
                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind QuantitySummary}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind QuantitySummary}" />
                <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind PerformanceSummary}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind PerformanceSummary}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
  </Grid>
</UserControl>
