<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Views.ImagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoE.ModelManager.Controls"
    xmlns:helpers="using:MoE.ModelManager.Helpers"
    IsTabStop="False">

  <Grid
      x:Name="ImagesRoot"
      Padding="{StaticResource PagePadding}"
      RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
          x:Uid="ImagesHeading"
          VerticalAlignment="Center"
          Style="{StaticResource PageTitleTextStyle}" />
      <controls:RuntimeControlBar
          Grid.Column="1"
          EjectAutomationId="EjectImageModelButton"
          EjectCommand="{x:Bind ViewModel.EjectImageModelCommand}"
          LoadAutomationId="LoadImageModelButton"
          LoadCommand="{x:Bind ViewModel.LoadImageModelCommand}"
          LogoUri="{x:Bind ViewModel.ImageModelLogo, Mode=OneWay}"
          ModelName="{x:Bind ViewModel.ImageModelName, Mode=OneWay}"
          Status="{x:Bind ViewModel.ImageRuntimeStatus, Mode=OneWay}"
          StatusText="{x:Bind ViewModel.ImageRuntimeStatusText, Mode=OneWay}" />
    </Grid>

    <InfoBar
        Grid.Row="1"
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.HasImageRuntimeDetail, Mode=OneWay}"
        Message="{x:Bind ViewModel.ImageRuntimeDetail, Mode=OneWay}"
        Severity="Error"
        Visibility="{x:Bind ViewModel.HasImageRuntimeDetail, Mode=OneWay}" />

    <Grid Grid.Row="2" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Padding="18" Style="{StaticResource CardBorderStyle}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox
              x:Uid="ImagePromptBox"
              MinHeight="160"
              MaxHeight="280"
              AcceptsReturn="True"
              AutomationProperties.AutomationId="ImagePromptBox"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              Text="{x:Bind ViewModel.ImagePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              TextWrapping="Wrap" />
          <ComboBox
              x:Uid="ImageSizePicker"
              Grid.Row="1"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="ImageSizePicker"
              ItemsSource="{x:Bind ViewModel.ImageSizes, Mode=OneTime}"
              SelectedItem="{x:Bind ViewModel.SelectedImageSize, Mode=TwoWay}" />
          <StackPanel Grid.Row="2" Spacing="6">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button
                  x:Uid="GenerateImageButton"
                  HorizontalAlignment="Stretch"
                  AccessKey="G"
                  AutomationProperties.AutomationId="GenerateImageButton"
                  Command="{x:Bind ViewModel.GenerateImageCommand}"
                  Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                  <KeyboardAccelerator
                      x:Name="GenerateImageAccelerator"
                      Key="Enter"
                      Modifiers="Control" />
                </Button.KeyboardAccelerators>
              </Button>
              <Button
                  x:Uid="CancelImageButton"
                  Grid.Column="1"
                  AutomationProperties.AutomationId="CancelImageButton"
                  Command="{x:Bind ViewModel.CancelImageGenerationCommand}" />
            </Grid>
            <TextBlock
                x:Uid="GenerateShortcutHint"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryCaptionTextStyle}" />
          </StackPanel>
          <StackPanel
              Grid.Row="4"
              Padding="0,14,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Spacing="4"
              Visibility="{x:Bind helpers:ViewHelpers.VisibleIfText(ViewModel.GeneratedImageSummary), Mode=OneWay}">
            <TextBlock x:Uid="LastResultHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Style="{StaticResource SecondaryBodyTextStyle}"
                Text="{x:Bind ViewModel.GeneratedImageSummary, Mode=OneWay}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border
          Grid.Column="1"
          Padding="0"
          Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar
              VerticalAlignment="Top"
              IsIndeterminate="True"
              Visibility="{x:Bind ViewModel.IsImageGenerating, Mode=OneWay}" />
          <StackPanel
              x:Name="ImagePlaceholder"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="10">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEB9F;" />
            <TextBlock
                x:Uid="ImagePlaceholderText"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryBodyTextStyle}" />
          </StackPanel>
          <Image
              x:Name="GeneratedImage"
              x:Uid="GeneratedImage"
              Margin="24"
              AutomationProperties.AutomationId="GeneratedImagePreview"
              Stretch="Uniform" />
          <Grid
              Grid.Row="1"
              Padding="16,10"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              ColumnSpacing="8"
              Visibility="{x:Bind ViewModel.HasGeneratedImage, Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                Style="{StaticResource SecondaryBodyTextStyle}"
                Text="{x:Bind ViewModel.GeneratedImageFileName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.GeneratedImagePath, Mode=OneWay}" />
            <Button
                x:Uid="OpenResultButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="OpenGeneratedImageButton"
                Click="OnOpenImageClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                <TextBlock x:Uid="OpenResultText" />
              </StackPanel>
            </Button>
            <Button
                x:Uid="ShowResultInFolderButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="ShowGeneratedImageButton"
                Click="OnShowImageInFolderClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                <TextBlock x:Uid="ShowResultInFolderText" />
              </StackPanel>
            </Button>
            <Button
                x:Uid="CopyResultPathButton"
                Grid.Column="3"
                Click="OnCopyImagePathClicked"
                Style="{StaticResource IconButtonStyle}">
              <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
