<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Views.VideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoE.ModelManager.Controls"
    xmlns:helpers="using:MoE.ModelManager.Helpers"
    IsTabStop="False">

  <Grid
      x:Name="VideoRoot"
      Padding="{StaticResource PagePadding}"
      RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
          x:Uid="VideoHeading"
          VerticalAlignment="Center"
          Style="{StaticResource PageTitleTextStyle}" />
      <controls:RuntimeControlBar
          Grid.Column="1"
          EjectAutomationId="EjectVideoModelButton"
          EjectCommand="{x:Bind ViewModel.EjectVideoModelCommand}"
          LoadAutomationId="LoadVideoModelButton"
          LoadCommand="{x:Bind ViewModel.LoadVideoModelCommand}"
          LogoUri="{x:Bind ViewModel.VideoModelLogo, Mode=OneWay}"
          ModelName="{x:Bind ViewModel.VideoModelName, Mode=OneWay}"
          Status="{x:Bind ViewModel.VideoRuntimeStatus, Mode=OneWay}"
          StatusText="{x:Bind ViewModel.VideoRuntimeStatusText, Mode=OneWay}" />
    </Grid>

    <InfoBar
        Grid.Row="1"
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.HasVideoRuntimeDetail, Mode=OneWay}"
        Message="{x:Bind ViewModel.VideoRuntimeDetail, Mode=OneWay}"
        Severity="Error"
        Visibility="{x:Bind ViewModel.HasVideoRuntimeDetail, Mode=OneWay}" />

    <Grid Grid.Row="2" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Padding="18" Style="{StaticResource CardBorderStyle}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox
              x:Uid="VideoPromptBox"
              MinHeight="160"
              MaxHeight="280"
              AcceptsReturn="True"
              AutomationProperties.AutomationId="VideoPromptBox"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              Text="{x:Bind ViewModel.VideoPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              TextWrapping="Wrap" />
          <ComboBox
              x:Uid="VideoPresetPicker"
              Grid.Row="1"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="VideoPresetPicker"
              DisplayMemberPath="DisplayName"
              ItemsSource="{x:Bind ViewModel.VideoPresets, Mode=OneTime}"
              SelectedItem="{x:Bind ViewModel.SelectedVideoPreset, Mode=TwoWay}" />
          <StackPanel Grid.Row="2" Spacing="6">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button
                  x:Uid="GenerateVideoButton"
                  HorizontalAlignment="Stretch"
                  AccessKey="R"
                  AutomationProperties.AutomationId="GenerateVideoButton"
                  Command="{x:Bind ViewModel.GenerateVideoCommand}"
                  Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                  <KeyboardAccelerator
                      x:Name="GenerateVideoAccelerator"
                      Key="Enter"
                      Modifiers="Control" />
                </Button.KeyboardAccelerators>
              </Button>
              <Button
                  x:Uid="CancelVideoButton"
                  Grid.Column="1"
                  AutomationProperties.AutomationId="CancelVideoButton"
                  Command="{x:Bind ViewModel.CancelVideoGenerationCommand}" />
            </Grid>
            <TextBlock
                x:Uid="GenerateShortcutHint"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryCaptionTextStyle}" />
          </StackPanel>
          <StackPanel
              Grid.Row="4"
              Padding="0,14,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Spacing="4"
              Visibility="{x:Bind helpers:ViewHelpers.VisibleIfText(ViewModel.GeneratedVideoSummary), Mode=OneWay}">
            <TextBlock x:Uid="LastResultHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Style="{StaticResource SecondaryBodyTextStyle}"
                Text="{x:Bind ViewModel.GeneratedVideoSummary, Mode=OneWay}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border
          Grid.Column="1"
          Padding="0"
          Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar
              VerticalAlignment="Top"
              IsIndeterminate="True"
              Visibility="{x:Bind ViewModel.IsVideoGenerating, Mode=OneWay}" />
          <StackPanel
              x:Name="VideoPlaceholder"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="10">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE714;" />
            <TextBlock
                x:Uid="VideoPlaceholderText"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryBodyTextStyle}" />
          </StackPanel>
          <MediaPlayerElement
              x:Name="GeneratedVideo"
              x:Uid="GeneratedVideo"
              Margin="24"
              AreTransportControlsEnabled="True"
              AutomationProperties.AutomationId="GeneratedVideoPreview"
              AutoPlay="False"
              Stretch="Uniform"
              Visibility="Collapsed" />
          <Grid
              Grid.Row="1"
              Padding="16,10"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              ColumnSpacing="8"
              Visibility="{x:Bind ViewModel.HasGeneratedVideo, Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                Style="{StaticResource SecondaryBodyTextStyle}"
                Text="{x:Bind ViewModel.GeneratedVideoFileName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.GeneratedVideoPath, Mode=OneWay}" />
            <Button
                x:Uid="OpenResultButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="OpenGeneratedVideoButton"
                Click="OnOpenVideoClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                <TextBlock x:Uid="OpenResultText" />
              </StackPanel>
            </Button>
            <Button
                x:Uid="ShowResultInFolderButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="ShowGeneratedVideoButton"
                Click="OnShowVideoInFolderClicked">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                <TextBlock x:Uid="ShowResultInFolderText" />
              </StackPanel>
            </Button>
            <Button
                x:Uid="CopyResultPathButton"
                Grid.Column="3"
                Click="OnCopyVideoPathClicked"
                Style="{StaticResource IconButtonStyle}">
              <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
