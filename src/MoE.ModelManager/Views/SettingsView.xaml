<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoE.ModelManager.Controls"
    xmlns:helpers="using:MoE.ModelManager.Helpers"
    IsTabStop="False">

  <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel
        MaxWidth="{StaticResource PageContentMaxWidth}"
        Padding="{StaticResource PagePadding}"
        HorizontalAlignment="Stretch">
      <TextBlock x:Uid="SettingsHeading" Style="{StaticResource PageTitleTextStyle}" />

      <TextBlock x:Uid="AppearanceHeading" Style="{StaticResource SectionHeaderTextStyle}" />
      <Border Style="{StaticResource CardBorderStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon
              VerticalAlignment="Center"
              FontSize="18"
              Glyph="&#xE790;" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ThemeLabel" x:Uid="ThemeLabel" />
            <TextBlock x:Uid="ThemeDescription" Style="{StaticResource SecondaryCaptionTextStyle}" />
          </StackPanel>
          <ComboBox
              Grid.Column="2"
              MinWidth="200"
              VerticalAlignment="Center"
              AutomationProperties.AutomationId="ThemePicker"
              AutomationProperties.LabeledBy="{x:Bind ThemeLabel}"
              SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
            <ComboBoxItem x:Uid="ThemeSystemItem" />
            <ComboBoxItem x:Uid="ThemeLightItem" />
            <ComboBoxItem x:Uid="ThemeDarkItem" />
          </ComboBox>
        </Grid>
      </Border>

      <TextBlock x:Uid="ChatHistorySettingsHeading" Style="{StaticResource SectionHeaderTextStyle}" />
      <StackPanel Spacing="4">
        <Border Style="{StaticResource CardBorderStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE81C;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SaveHistoryLabel" x:Uid="SaveHistoryLabel" />
              <TextBlock
                  x:Uid="SaveHistoryDescription"
                  Style="{StaticResource SecondaryCaptionTextStyle}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                x:Uid="SaveHistoryToggle"
                Grid.Column="2"
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SaveHistoryToggle"
                AutomationProperties.LabeledBy="{x:Bind SaveHistoryLabel}"
                IsOn="{x:Bind ViewModel.IsChatHistoryEnabled, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE8B7;" />
            <controls:PathRow
                x:Uid="HistoryFolderRow"
                Grid.Column="1"
                PathText="{x:Bind ViewModel.HistoryDirectory, Mode=OneTime}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE74D;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Uid="DeleteHistoryLabel" />
              <TextBlock
                  x:Uid="DeleteHistoryDescription"
                  Style="{StaticResource SecondaryCaptionTextStyle}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Uid="DeleteHistoryButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="DeleteHistoryButton"
                Click="OnDeleteHistoryClicked"
                IsEnabled="{x:Bind helpers:ViewHelpers.Not(ViewModel.HasNoConversations), Mode=OneWay}" />
          </Grid>
        </Border>
      </StackPanel>

      <TextBlock x:Uid="AboutHeading" Style="{StaticResource SectionHeaderTextStyle}" />
      <Border Style="{StaticResource CardBorderStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image
              Width="48"
              Height="48"
              AutomationProperties.AccessibilityView="Raw"
              Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-unplated.png" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Uid="AboutAppName" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                x:Name="VersionText"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                IsTextSelectionEnabled="True" />
            <TextBlock
                x:Uid="AboutDescription"
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryBodyTextStyle}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
