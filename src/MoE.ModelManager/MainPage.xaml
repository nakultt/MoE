<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoE.ModelManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MoE.ModelManager.Views"
    mc:Ignorable="d">

  <NavigationView
      x:Name="NavView"
      AutomationProperties.AutomationId="MainNavigation"
      CompactModeThresholdWidth="720"
      ExpandedModeThresholdWidth="1180"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False"
      IsSettingsVisible="True"
      IsTitleBarAutoPaddingEnabled="False"
      OpenPaneLength="260"
      PaneDisplayMode="Auto"
      SelectionChanged="OnNavigationSelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem
          x:Name="ChatNavItem"
          x:Uid="ChatNavItem"
          AutomationProperties.AutomationId="ChatTab"
          Tag="Chat">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE8BD;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem
          x:Uid="ImagesNavItem"
          AutomationProperties.AutomationId="ImagesTab"
          Tag="Images">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xEB9F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem
          x:Uid="VideoNavItem"
          AutomationProperties.AutomationId="VideosTab"
          Tag="Video">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE714;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem
          x:Uid="AudioNavItem"
          AutomationProperties.AutomationId="AudioTab"
          Tag="Audio">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE720;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItemHeader x:Uid="ManageNavHeader" />
      <NavigationViewItem
          x:Uid="ModelsNavItem"
          AutomationProperties.AutomationId="ModelsTab"
          Tag="Models">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE8F1;" />
        </NavigationViewItem.Icon>
        <NavigationViewItem.InfoBadge>
          <InfoBadge Value="{x:Bind ViewModel.LoadedRuntimeCount, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLoadedRuntimes, Mode=OneWay}" />
        </NavigationViewItem.InfoBadge>
      </NavigationViewItem>
      <NavigationViewItem
          x:Uid="ApiNavItem"
          AutomationProperties.AutomationId="ApiTab"
          Tag="Api">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE943;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <NavigationView.PaneFooter>
      <StackPanel
          Margin="16,8,16,12"
          AutomationProperties.AutomationId="RuntimeSummary"
          Spacing="4"
          Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse
              Width="8"
              Height="8"
              VerticalAlignment="Center"
              Fill="{ThemeResource SystemFillColorSuccessBrush}"
              Visibility="{x:Bind ViewModel.IsApiListening, Mode=OneWay}" />
          <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="{x:Bind ViewModel.ApiStatusText, Mode=OneWay}" />
        </StackPanel>
        <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind ViewModel.LoadedModelsText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            ToolTipService.ToolTip="{x:Bind ViewModel.LoadedModelsText, Mode=OneWay}" />
      </StackPanel>
    </NavigationView.PaneFooter>

    <Grid>
      <views:ChatView x:Name="ChatSection" />
      <views:ImagesView x:Name="ImagesSection" Visibility="Collapsed" />
      <views:VideoView x:Name="VideoSection" Visibility="Collapsed" />
      <views:AudioView x:Name="AudioSection" Visibility="Collapsed" />
      <views:ModelsView x:Name="ModelsSection" Visibility="Collapsed" />
      <views:ApiView x:Name="ApiSection" Visibility="Collapsed" />
      <views:SettingsView x:Name="SettingsSection" Visibility="Collapsed" />
    </Grid>
  </NavigationView>
</Page>
