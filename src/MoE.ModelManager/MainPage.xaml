<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoE.ModelManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MoE.ModelManager.Controls"
    xmlns:models="using:MoE.ModelManager.Models"
    mc:Ignorable="d">

  <Grid Padding="24" ColumnSpacing="16" RowSpacing="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.ColumnSpan="3" Spacing="4">
      <TextBlock x:Uid="AppHeading" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock
          x:Uid="AppSubheading"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Style="{ThemeResource BodyTextBlockStyle}" />
    </StackPanel>

    <Border
        Grid.Row="1"
        Grid.Column="0"
        Padding="18"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
      <StackPanel Spacing="14">
        <TextBlock x:Uid="ModelsHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <ComboBox
            x:Name="ModelPicker"
            x:Uid="ModelPicker"
            AutomationProperties.AutomationId="ModelPicker"
            AccessKey="M"
            ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:ModelDefinition">
              <TextBlock Text="{x:Bind DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.SelectedDescription, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            Text="{x:Bind ViewModel.SelectedMeasuredSpeed, Mode=OneWay}" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button
              x:Name="LoadButton"
              x:Uid="LoadButton"
              AutomationProperties.AutomationId="LoadModelButton"
              AccessKey="L"
              Command="{x:Bind ViewModel.LoadModelCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Style="{StaticResource AccentButtonStyle}" />
          <Button
              x:Name="EjectButton"
              x:Uid="EjectButton"
              Grid.Column="1"
              AutomationProperties.AutomationId="EjectModelButton"
              AccessKey="E"
              Command="{x:Bind ViewModel.EjectModelCommand}" />
        </Grid>
        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0" />
        <TextBlock
            x:Uid="RuntimeStatusLabel"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.RuntimeDetail, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Uid="ModelPathLabel"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock
            FontFamily="Consolas"
            FontSize="11"
            IsTextSelectionEnabled="True"
            Text="{x:Bind ViewModel.SelectedModelPath, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0" />
        <TextBlock x:Uid="ApiHeading" FontWeight="SemiBold" />
        <TextBlock
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            IsTextSelectionEnabled="True"
            Text="{x:Bind ViewModel.ApiBaseUrl, Mode=OneTime}" />
        <TextBlock Text="{x:Bind ViewModel.ApiStatusText, Mode=OneWay}" />
        <TextBlock
            x:Uid="ApiHint"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border
        Grid.Row="1"
        Grid.Column="1"
        Padding="18"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="ChatHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <ListView
            x:Name="ChatList"
            x:Uid="ChatList"
            Grid.Row="1"
            AutomationProperties.AutomationId="ChatMessageList"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
            SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:ChatMessage">
              <Border
                  Margin="0,4"
                  Padding="12"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  CornerRadius="8">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind Author, Mode=OneWay}" />
                  <controls:MarkdownRichTextBlock
                      Markdown="{x:Bind Content, Mode=OneWay}"
                      RenderMarkdown="{x:Bind IsAssistant, Mode=OneTime}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
              x:Name="PromptBox"
              x:Uid="PromptBox"
              AutomationProperties.AutomationId="ChatPromptBox"
              AcceptsReturn="True"
              MaxHeight="160"
              MinHeight="72"
              Text="{x:Bind ViewModel.UserPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              TextWrapping="Wrap" />
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
            <Button
                x:Name="SendButton"
                x:Uid="SendButton"
                AutomationProperties.AutomationId="SendMessageButton"
                AccessKey="S"
                Command="{x:Bind ViewModel.SendMessageCommand}"
                Style="{StaticResource AccentButtonStyle}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Enter" Modifiers="Control" />
              </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Name="StopButton"
                x:Uid="StopButton"
                AutomationProperties.AutomationId="StopGenerationButton"
                Command="{x:Bind ViewModel.CancelGenerationCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Grid.Column="2"
        Padding="18"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="ActivityHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock
            x:Uid="ActivitySubheading"
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="2">
          <TextBlock
              x:Uid="NoActivity"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Visibility="{x:Bind ViewModel.HasNoMetrics, Mode=OneWay}" />
          <ListView
              x:Name="ActivityList"
              x:Uid="ActivityList"
              AutomationProperties.AutomationId="RequestActivityList"
              ItemsSource="{x:Bind ViewModel.RequestMetrics, Mode=OneWay}"
              SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:RequestMetric">
                <Border
                    Margin="0,4"
                    Padding="10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                  <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock FontWeight="SemiBold" Text="{x:Bind Source}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind TimeSummary}" />
                    </Grid>
                    <TextBlock FontFamily="Consolas" FontSize="11" Text="{x:Bind Endpoint}" />
                    <TextBlock Text="{x:Bind Model}" TextTrimming="CharacterEllipsis" />
                    <TextBlock>
                      <Run Text="{x:Bind CompletionTokens}" />
                      <Run x:Uid="GeneratedTokensSuffix" />
                      <Run x:Uid="MetricSeparator" />
                      <Run Text="{x:Bind PromptTokens}" />
                      <Run x:Uid="PromptTokensSuffix" />
                    </TextBlock>
                    <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                      <Run Text="{x:Bind TokensPerSecondText}" />
                      <Run x:Uid="TokensPerSecondSuffix" />
                      <Run x:Uid="MetricSeparator" />
                      <Run Text="{x:Bind DurationSecondsText}" />
                      <Run x:Uid="SecondsSuffix" />
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
