<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Controls.ModelCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoE.ModelManager.Controls"
    xmlns:helpers="using:MoE.ModelManager.Helpers"
    IsTabStop="False">

  <Border Padding="0" Style="{StaticResource CardBorderStyle}">
    <StackPanel>
      <Grid Padding="16,14" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image
            Width="40"
            Height="40"
            VerticalAlignment="Top"
            AutomationProperties.AccessibilityView="Raw">
          <Image.Source>
            <BitmapImage
                DecodePixelHeight="80"
                DecodePixelType="Logical"
                DecodePixelWidth="80"
                UriSource="{x:Bind LogoUri, Mode=OneWay}" />
          </Image.Source>
        </Image>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
          <TextBlock
              Style="{StaticResource SecondaryCaptionTextStyle}"
              Text="{x:Bind helpers:ViewHelpers.Caption(Kind, Publisher), Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
          <TextBlock
              Style="{StaticResource BodyStrongTextBlockStyle}"
              Text="{x:Bind ModelName, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
          <TextBlock
              MaxLines="2"
              Style="{StaticResource SecondaryBodyTextStyle}"
              Text="{x:Bind Description, Mode=OneWay}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="Wrap" />
          <ItemsRepeater
              Margin="0,6,0,0"
              ItemsSource="{x:Bind Tags, Mode=OneWay}"
              Visibility="{x:Bind helpers:ViewHelpers.VisibleIfNotNull(Tags), Mode=OneWay}">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Horizontal" Spacing="6" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Style="{StaticResource TagBorderStyle}">
                  <TextBlock
                      FontSize="11"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind}" />
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
          <ContentPresenter VerticalAlignment="Center" Content="{x:Bind Accessory, Mode=OneWay}" />
          <controls:StatusBadge Status="{x:Bind Status, Mode=OneWay}" Text="{x:Bind StatusText, Mode=OneWay}" />
          <Grid>
            <Button
                x:Name="LoadButton"
                x:Uid="RuntimeLoadButton"
                MinWidth="88"
                AutomationProperties.AutomationId="{x:Bind LoadAutomationId, Mode=OneWay}"
                Command="{x:Bind LoadCommand, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind helpers:ViewHelpers.LoadVisibility(Status), Mode=OneWay}" />
            <Button
                x:Name="EjectButton"
                x:Uid="RuntimeEjectButton"
                MinWidth="88"
                AutomationProperties.AutomationId="{x:Bind EjectAutomationId, Mode=OneWay}"
                Command="{x:Bind EjectCommand, Mode=OneWay}"
                Visibility="{x:Bind helpers:ViewHelpers.EjectVisibility(Status), Mode=OneWay}" />
          </Grid>
        </StackPanel>
      </Grid>
      <InfoBar
          Margin="72,0,16,14"
          IsClosable="False"
          IsOpen="{x:Bind helpers:ViewHelpers.HasText(ErrorText), Mode=OneWay}"
          Message="{x:Bind ErrorText, Mode=OneWay}"
          Severity="Error"
          Visibility="{x:Bind helpers:ViewHelpers.VisibleIfText(ErrorText), Mode=OneWay}" />
      <Border
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0"
          Visibility="{x:Bind helpers:ViewHelpers.VisibleIfNotNull(Details), Mode=OneWay}">
        <Expander
            x:Uid="ModelFilesExpander"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Content="{x:Bind Details, Mode=OneWay}">
          <Expander.Resources>
            <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderContentBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentPadding">72,4,16,14</Thickness>
          </Expander.Resources>
        </Expander>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
