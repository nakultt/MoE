<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

  <Border
      x:Name="BadgeRoot"
      Height="24"
      Padding="10,0,12,0"
      VerticalAlignment="Center"
      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
      CornerRadius="12">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="StatusStates">
        <VisualState x:Name="StatusUnloaded" />
        <VisualState x:Name="StatusLoading">
          <VisualState.Setters>
            <Setter Target="BadgeRoot.Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
            <Setter Target="Dot.Visibility" Value="Collapsed" />
            <Setter Target="Spinner.Visibility" Value="Visible" />
            <Setter Target="Spinner.IsActive" Value="True" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StatusEjecting">
          <VisualState.Setters>
            <Setter Target="Dot.Visibility" Value="Collapsed" />
            <Setter Target="Spinner.Visibility" Value="Visible" />
            <Setter Target="Spinner.IsActive" Value="True" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StatusReady">
          <VisualState.Setters>
            <Setter Target="BadgeRoot.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Target="Dot.StrokeThickness" Value="0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StatusError">
          <VisualState.Setters>
            <Setter Target="BadgeRoot.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
            <Setter Target="Dot.Visibility" Value="Collapsed" />
            <Setter Target="ErrorGlyph.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="7">
      <Ellipse
          x:Name="Dot"
          Width="8"
          Height="8"
          VerticalAlignment="Center"
          Fill="Transparent"
          Stroke="{ThemeResource TextFillColorSecondaryBrush}"
          StrokeThickness="1.5" />
      <ProgressRing
          x:Name="Spinner"
          Width="12"
          Height="12"
          MinWidth="12"
          MinHeight="12"
          VerticalAlignment="Center"
          IsActive="False"
          Visibility="Collapsed" />
      <FontIcon
          x:Name="ErrorGlyph"
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
          Glyph="&#xE783;"
          Visibility="Collapsed" />
      <TextBlock
          x:Name="Label"
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
          Text="{x:Bind Text, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</UserControl>
