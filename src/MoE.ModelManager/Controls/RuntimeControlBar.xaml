<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoE.ModelManager.Controls.RuntimeControlBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoE.ModelManager.Controls"
    xmlns:helpers="using:MoE.ModelManager.Helpers"
    IsTabStop="False">

  <Grid ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image
        Width="20"
        Height="20"
        VerticalAlignment="Center"
        AutomationProperties.AccessibilityView="Raw">
      <Image.Source>
        <BitmapImage
            DecodePixelHeight="40"
            DecodePixelType="Logical"
            DecodePixelWidth="40"
            UriSource="{x:Bind LogoUri, Mode=OneWay}" />
      </Image.Source>
    </Image>
    <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="{x:Bind ModelName, Mode=OneWay}"
        TextTrimming="CharacterEllipsis"
        ToolTipService.ToolTip="{x:Bind ModelName, Mode=OneWay}" />
    <controls:StatusBadge
        Grid.Column="2"
        Status="{x:Bind Status, Mode=OneWay}"
        Text="{x:Bind StatusText, Mode=OneWay}" />
    <Grid Grid.Column="3">
      <Button
          x:Name="LoadButton"
          x:Uid="RuntimeLoadButton"
          MinWidth="84"
          AutomationProperties.AutomationId="{x:Bind LoadAutomationId, Mode=OneWay}"
          Command="{x:Bind LoadCommand, Mode=OneWay}"
          Style="{StaticResource AccentButtonStyle}"
          Visibility="{x:Bind helpers:ViewHelpers.LoadVisibility(Status), Mode=OneWay}" />
      <Button
          x:Name="EjectButton"
          x:Uid="RuntimeEjectButton"
          MinWidth="84"
          AutomationProperties.AutomationId="{x:Bind EjectAutomationId, Mode=OneWay}"
          Command="{x:Bind EjectCommand, Mode=OneWay}"
          Visibility="{x:Bind helpers:ViewHelpers.EjectVisibility(Status), Mode=OneWay}" />
    </Grid>
  </Grid>
</UserControl>
