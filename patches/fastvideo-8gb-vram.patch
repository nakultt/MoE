+    # Finally shard the entire model to account for any stragglers. On a
+    # single-GPU inference worker with CPU offload, wrapping the root after all
+    # child layers are already wrapped briefly materializes the complete model
+    # on CUDA. That initialization spike exceeds 8 GB for UMT5-XXL even though
+    # every individual layer fits. The configured conditions include the Wan
+    # encoder blocks, embeddings and final norm, so no trainable parameters are
+    # left unwrapped in this inference-only path.
+    skip_cpu_offload_root = (
+        cpu_offload
+        and os.environ.get("FASTVIDEO_CPU_OFFLOAD_SKIP_ROOT", "0") == "1"
+    )
+    if not skip_cpu_offload_root:
+        root_kwargs = fsdp_kwargs
+        if ignored_params:
+            root_kwargs = {**fsdp_kwargs, "ignored_params": ignored_params}
+        fully_shard(model, **root_kwargs)
 
 
