diff --git a/fastvideo/worker/gpu_worker.py b/fastvideo/worker/gpu_worker.py
index b4f8e62..cfd810c 100644
--- a/fastvideo/worker/gpu_worker.py
+++ b/fastvideo/worker/gpu_worker.py
@@ -76,10 +76,21 @@ class Worker:
         needs_output = forward_batch.return_frames or (forward_batch.save_video
                                                        and fastvideo_args.output_type != "latent"
                                                        and not output_batch.extra.get("audio_only"))
-        if output_batch.output is not None and not needs_output:
-            # Drop the decoded tensor before multiprocessing or Ray transports
-            # the worker result back to the generator.
-            output_batch.output = torch.empty(0, device="cpu")
+        if output_batch.output is not None:
+            if needs_output:
+                # CUDA IPC needs an additional device allocation while
+                # serializing tensors to the API process. On an 8 GB card the
+                # decoded video and active model layers leave no room for that
+                # allocation, even though inference itself completed. Copy the
+                # final media tensor to host memory before multiprocessing
+                # transport; the generator immediately consumes it on CPU for
+                # frame conversion and MP4 encoding.
+                output_batch.output = output_batch.output.to("cpu")
+                torch.cuda.empty_cache()
+            else:
+                # Drop the decoded tensor before multiprocessing or Ray transports
+                # the worker result back to the generator.
+                output_batch.output = torch.empty(0, device="cpu")
         return cast(ForwardBatch, output_batch)
 
     def shutdown(self) -> dict[str, Any]:
